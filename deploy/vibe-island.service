[Unit]
Description=Vibe Island focus sanctuary
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vibe-island
Group=vibe-island
WorkingDirectory=/opt/vibe-island/current
ExecStart=/opt/node24/bin/node --max-old-space-size=256 server/index.mjs
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4173
Environment=DATA_DIR=/var/lib/vibe-island
Environment=TRUST_PROXY=1
Environment=PUBLIC_SITE=1
Restart=on-failure
RestartSec=3
TimeoutStopSec=25
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/vibe-island
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0027
MemoryMax=512M

[Install]
WantedBy=multi-user.target
